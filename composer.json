{
    "name": "vojtechrichter/ledger",
    "require": {
        "symfony/http-foundation": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/console": "^8.1",
        "doctrine/dbal": "^4.4",
        "ramsey/uuid": "^4.9",
        "league/openapi-psr7-validator": "^0.24.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ledger\\": "src/Ledger/",
            "Identity\\": "src/Identity/",
            "Shared\\": "src/Shared/"
        }
    },
    "authors": [
        {
            "name": "vojtechrichter",
            "email": "vojtechrichter11@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "tests": "export XDEBUG_MODE=coverage && vendor/bin/phpunit --fail-on-warning"
    }
}
